# app3 专用环境变量模板 —— 复制本文件为同目录下的 `.env` 后填写（勿提交 `.env`）。
# 与 app2/farmland 解耦；在本地 `.env` 中维护真实密钥。

# ---------- LLM（对话 / LangGraph）----------
OPENAI_API_KEY=
# OpenAI 兼容 Base URL；若用 Moonshot/Kimi 等请填写对应地址
OPENAI_BASE_URL=
MOONSHOT_MODEL=gpt-4o-mini
# OPENAI_MODEL=

# ---------- Neo4j（形态 A/C；与 docker-compose.neo4j.yml 默认口令对齐时可沿用下列示例）----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphragtest
# NEO4J_DATABASE=neo4j

# ---------- 嵌入向量（GraphRAG / embed_chunks；可与对话 LLM 不同供应商）----------
# 使用 OpenAI 官方 SDK：`OpenAI(api_key=..., base_url=...)` + `embeddings.create(...)`。
# EMBEDDING_* 优先于 OPENAI_*，用于仅嵌入。
#
# 第三方 OpenAI 兼容网关示例：
#   EMBEDDING_API_KEY=<你的密钥>
#   EMBEDDING_BASE_URL=https://api.laozhang.ai/v1
#
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------- 形态 C GraphRAG ----------
GRAPH_RAG_ENABLED=0
NEO4J_CHUNK_VECTOR_INDEX=chunk_embedding_index

# ---------- 可选：额外 env 文件（会与 app3/.env 顺序合并，缺省键由后者补全）----------
# APP3_ENV_FILE=
