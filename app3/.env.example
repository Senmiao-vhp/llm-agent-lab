# app3 专用环境变量模板 —— 复制本文件为同目录下的 `.env` 后填写（勿提交 `.env`）。
# 与 app2/farmland 解耦；在本地 `.env` 中维护真实密钥。
# 运行时由 app3.config.Settings.from_env() 统一读取（含本文件合并进进程环境）；业务代码禁止直接 os.getenv。
# 布尔开关请写 true / false（大小写不敏感），勿使用 0/1。

# ---------- LLM（对话 / LangGraph）----------
OPENAI_API_KEY=
# OpenAI 兼容 Base URL；若用 Moonshot/Kimi 等请填写对应地址
OPENAI_BASE_URL=
MOONSHOT_MODEL=gpt-4o-mini
# OPENAI_MODEL=

# ---------- 解释（可选二次调用 LLM）----------
# 为 true 时：解释节点在模板摘要外再调用一次 LLM（需可用 API Key）。
# 解析仅结构化 LLM：未配置对话模型时 parse 节点直接 fatal，不再产出占位 parse_result。
# APP3_EXPLAINER_LLM=false

# ---------- 规划（固定 DSL vs LLM bind_tools）----------
# 为 false 时：plan 节点将 parse_result 编译为 gis_execute_pipeline 的 DSL（无需规划 LLM）。
# APP3_PLAN_USE_LLM=true
# 覆盖默认的 app3/config/planner_params.json（NDVI、变化检测导出、趋势并行等）
# APP3_PLANNER_PARAMS=

# ---------- GIS（轻量：Nominatim / bbox；完整算子栈见 pip install -e .[gis]）----------
# 本地数据：可将 farmland-monitoring/data/{raw,processed} 复制到本仓库 app3/data/（见仓库根 .gitignore，大数据勿提交）。
# resolve_geometry：未配置 GEE 时仅用 OSM Nominatim（需外网）。
# APP3_GIS_NOMINATIM=true
# APP3_NOMINATIM_USER_AGENT=app3-agent-lab/0.1 (your-contact-url-or-email)
#
# 完整 WorkflowExecutor / gis_execute_pipeline（GlobeLand、栅格、EE）：
#   pip install -e ".[gis]"
# APP3_GEE_PROJECT_ID=
# GEE_PROJECT_ID=

# 数据根目录（内含 raw/GlobeLand30.2020、raw/admin_boundaries、processed 分幅）：默认 <app3>/data/
# APP3_DATA_DIR=
# APP3_GLOBELAND30_DIR=
# APP3_GIS_CACHE_DIR=
# APP3_GIS_USE_CACHE=true
# GEE 失败后尝试 OSM 边界（对应迁移前 APP2_GEO_NOMINATIM）
# APP3_GEO_FALLBACK_NOMINATIM=false
# 子计划并行（DSL metadata.subplans）
# APP3_EXECUTOR_PARALLEL=true

# ---------- Neo4j（形态 A/C；与 docker-compose.neo4j.yml 默认口令对齐时可沿用下列示例）----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphragtest
# NEO4J_DATABASE=neo4j

# ---------- 嵌入向量（GraphRAG / embed_chunks；可与对话 LLM 不同供应商）----------
# 使用 OpenAI 官方 SDK：`OpenAI(api_key=..., base_url=...)` + `embeddings.create(...)`。
# EMBEDDING_* 优先于 OPENAI_*，用于仅嵌入。
#
# 第三方 OpenAI 兼容网关示例：
#   EMBEDDING_API_KEY=<你的密钥>
#   EMBEDDING_BASE_URL=https://api.laozhang.ai/v1
#
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------- 形态 C GraphRAG ----------
GRAPH_RAG_ENABLED=false
NEO4J_CHUNK_VECTOR_INDEX=chunk_embedding_index
